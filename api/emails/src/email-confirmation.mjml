<mjml lang="en">
  <mj-head>
    <mj-title>Confirm your email address</mj-title>
    <mj-preview>One quick step to activate your account.</mj-preview>
    <mj-font name="Cormorant" href="https://fonts.googleapis.com/css2?family=Cormorant:wght@400;600&amp;display=swap" />
    <mj-font name="Nunito" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="Nunito, Arial, sans-serif" />
      <mj-text color="#111111" font-size="15px" line-height="1.7" padding="0 40px" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-html-attributes>
      <mj-selector path=".email-heading div">
        <mj-html-attribute name="role">heading</mj-html-attribute>
        <mj-html-attribute name="aria-level">1</mj-html-attribute>
      </mj-selector>
    </mj-html-attributes>
  </mj-head>
  <mj-body background-color="#f2f2f2" width="600px">

    <!-- Header -->
    <mj-section background-color="#111111" padding="28px 40px">
      <mj-column>
        <mj-text font-family="Cormorant, Georgia, serif" font-size="20px"
          font-weight="600" letter-spacing="4px" color="#9a7b3b"
          align="center" text-transform="uppercase" padding="0">
          Clothing Store
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Gold accent bar -->
    <mj-section background-color="#9a7b3b">
      <mj-column>
        <mj-spacer height="2px" />
      </mj-column>
    </mj-section>

    <!-- Main content -->
    <mj-section background-color="#ffffff" padding="48px 40px 40px">
      <mj-column>
        <mj-text css-class="email-heading" font-family="Cormorant, Georgia, serif"
          font-size="30px" font-weight="600" color="#111111" align="center"
          line-height="1.3" padding="0 0 20px">
          Confirm your email
        </mj-text>
        <mj-text align="center" color="#444444" padding="0 0 32px">
          Thanks for registering. Click the button below to confirm your email address and activate your account.
        </mj-text>
        <mj-button href="__CONFIRM_URL__" background-color="#111111" color="#ffffff"
          font-family="Nunito, Arial, sans-serif" font-size="13px"
          letter-spacing="2px" text-transform="uppercase"
          border-radius="0" inner-padding="14px 36px" align="center"
          padding="0 0 40px">
          Confirm Email
        </mj-button>
        <mj-divider border-color="#e8e8e8" border-width="1px" padding="0" />
        <mj-spacer height="24px" />
        <mj-text font-size="13px" color="#999999" align="center" padding="0">
          This link expires in 24&nbsp;hours. If you didn't register, you can safely ignore this email.
        </mj-text>
        <mj-spacer height="8px" />
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#fafafa" padding="20px 40px">
      <mj-column>
        <mj-text font-size="12px" color="#aaaaaa" align="center" padding="0">
          &copy; Clothing Store. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>

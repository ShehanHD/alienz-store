<mjml lang="en">
  <mj-head>
    <mj-title>Your enquiry has been accepted</mj-title>
    <mj-preview>Great news — your enquiry has been accepted.</mj-preview>
    <mj-font name="Cormorant" href="https://fonts.googleapis.com/css2?family=Cormorant:wght@400;600&amp;display=swap" />
    <mj-font name="Nunito" href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="Nunito, Arial, sans-serif" />
      <mj-text color="#111111" font-size="15px" line-height="1.7" padding="0 40px" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-html-attributes>
      <mj-selector path=".email-heading div">
        <mj-html-attribute name="role">heading</mj-html-attribute>
        <mj-html-attribute name="aria-level">1</mj-html-attribute>
      </mj-selector>
    </mj-html-attributes>
  </mj-head>
  <mj-body background-color="#f2f2f2" width="600px">

    <!-- Header -->
    <mj-section background-color="#111111" padding="28px 40px">
      <mj-column>
        <mj-text font-family="Cormorant, Georgia, serif" font-size="20px"
          font-weight="600" letter-spacing="4px" color="#9a7b3b"
          align="center" text-transform="uppercase" padding="0">
          Clothing Store
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Gold accent bar -->
    <mj-section background-color="#9a7b3b">
      <mj-column>
        <mj-spacer height="2px" />
      </mj-column>
    </mj-section>

    <!-- Greeting -->
    <mj-section background-color="#ffffff" padding="48px 0 32px">
      <mj-column>
        <mj-text css-class="email-heading" font-family="Cormorant, Georgia, serif"
          font-size="30px" font-weight="600" color="#111111" align="center"
          line-height="1.3" padding="0 40px 16px">
          Great news, __NAME__
        </mj-text>
        <mj-text align="center" color="#444444" padding="0 40px 32px">
          Your enquiry has been accepted. Here is a summary of your order.
        </mj-text>
        <mj-divider border-color="#e8e8e8" border-width="1px" padding="0 40px" />
      </mj-column>
    </mj-section>

    <!-- Product image (conditional — markers removed or block stripped by Python) -->
    <mj-raw>%%PRODUCT_IMAGE_START%%</mj-raw>
    <mj-section background-color="#ffffff" padding="32px 40px 0">
      <mj-column>
        <mj-image src="__PRODUCT_IMAGE__" alt="Product" border-radius="4px"
          padding="0" />
      </mj-column>
    </mj-section>
    <mj-raw>%%PRODUCT_IMAGE_END%%</mj-raw>

    <!-- Invoice table -->
    <mj-section background-color="#ffffff" padding="24px 40px 40px">
      <mj-column>
        <mj-text font-family="Cormorant, Georgia, serif" font-size="18px"
          font-weight="600" color="#111111" padding="0 0 16px">
          Order summary
        </mj-text>
        <mj-table font-family="Nunito, Arial, sans-serif" font-size="14px"
          color="#111111" line-height="1.6" padding="0" width="100%">
          __INVOICE_ROWS__
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#fafafa" padding="20px 40px">
      <mj-column>
        <mj-text font-size="12px" color="#aaaaaa" align="center" padding="0">
          &copy; Clothing Store. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>

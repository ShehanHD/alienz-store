<mjml lang="en">
  <mj-head>
    <mj-title>New Enquiry — Clothing Store</mj-title>
    <mj-preview>A new customer enquiry has been submitted.</mj-preview>
    <mj-font name="Cormorant" href="https://fonts.googleapis.com/css2?family=Cormorant:wght@400;600&amp;display=swap" />
    <mj-font name="Nunito" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="Nunito, Arial, sans-serif" />
      <mj-text color="#111111" font-size="15px" line-height="1.7" padding="0 40px" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-html-attributes>
      <mj-selector path=".email-heading div">
        <mj-html-attribute name="role">heading</mj-html-attribute>
        <mj-html-attribute name="aria-level">1</mj-html-attribute>
      </mj-selector>
    </mj-html-attributes>
  </mj-head>
  <mj-body background-color="#f2f2f2" width="600px">

    <!-- Header -->
    <mj-section background-color="#111111" padding="28px 40px">
      <mj-column>
        <mj-text font-family="Cormorant, Georgia, serif" font-size="20px"
          font-weight="600" letter-spacing="4px" color="#9a7b3b"
          align="center" text-transform="uppercase" padding="0">
          Clothing Store
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Gold accent bar -->
    <mj-section background-color="#9a7b3b">
      <mj-column>
        <mj-spacer height="2px" />
      </mj-column>
    </mj-section>

    <!-- Alert banner -->
    <mj-section background-color="#fafafa" padding="32px 40px 24px">
      <mj-column>
        <mj-text css-class="email-heading" font-family="Cormorant, Georgia, serif"
          font-size="26px" font-weight="600" color="#111111" align="left"
          line-height="1.3" padding="0 0 8px">
          New enquiry from __NAME__
        </mj-text>
        <mj-text font-size="13px" color="#888888" padding="0">
          Submitted via the Clothing Store website.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Details table -->
    <mj-section background-color="#ffffff" padding="24px 40px 32px">
      <mj-column>
        <mj-table font-family="Nunito, Arial, sans-serif" font-size="14px"
          color="#111111" line-height="1.6" padding="0">
          <tr style="border-bottom:1px solid #e8e8e8;">
            <td style="padding:10px 20px 10px 0;color:#888888;width:120px;font-size:12px;text-transform:uppercase;letter-spacing:1px;">Name</td>
            <td style="padding:10px 0;">__NAME__</td>
          </tr>
          <tr style="border-bottom:1px solid #e8e8e8;">
            <td style="padding:10px 20px 10px 0;color:#888888;width:120px;font-size:12px;text-transform:uppercase;letter-spacing:1px;">Email</td>
            <td style="padding:10px 0;"><a href="mailto:__EMAIL__" style="color:#9a7b3b;text-decoration:none;">__EMAIL__</a></td>
          </tr>
          <tr style="border-bottom:1px solid #e8e8e8;">
            <td style="padding:10px 20px 10px 0;color:#888888;width:120px;font-size:12px;text-transform:uppercase;letter-spacing:1px;">Phone</td>
            <td style="padding:10px 0;">__PHONE__</td>
          </tr>
          __PRODUCT_ROWS__
          <tr>
            <td style="padding:10px 20px 10px 0;color:#888888;width:120px;font-size:12px;text-transform:uppercase;letter-spacing:1px;">Message</td>
            <td style="padding:10px 0;">__MESSAGE__</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- CTA -->
    <mj-section background-color="#ffffff" padding="0 40px 40px">
      <mj-column>
        <mj-button href="__ADMIN_URL__" background-color="#111111" color="#ffffff"
          font-family="Nunito, Arial, sans-serif" font-size="13px"
          letter-spacing="2px" text-transform="uppercase"
          border-radius="0" inner-padding="14px 36px" align="left" padding="0">
          View in Admin Panel
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#fafafa" padding="20px 40px">
      <mj-column>
        <mj-text font-size="12px" color="#aaaaaa" align="center" padding="0">
          &copy; Clothing Store Admin Notifications
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
